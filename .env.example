# Required for the standard web and conversational research paths.
GEMINI_API_KEY=
SERPAPI_API_KEY=
NEWSAPI_API_KEY=

# Deep thinking runs Instagram scraping through Apify only; this token is
# read by server-only code and must never be exposed to browser/client code.
APIFY_API_TOKEN=

# Actor IDs may be overridden if your Apify account uses different Actor builds.
# Deep thinking hashtag/keyword search reads the Hashtag Scraper setting below.
APIFY_INSTAGRAM_SCRAPER_ACTOR_ID=apify/instagram-scraper
APIFY_INSTAGRAM_PROFILE_SCRAPER_ACTOR_ID=apify/instagram-profile-scraper
APIFY_INSTAGRAM_REEL_SCRAPER_ACTOR_ID=apify/instagram-reel-scraper
APIFY_INSTAGRAM_HASHTAG_SCRAPER_ACTOR_ID=apify/instagram-hashtag-scraper
APIFY_INSTAGRAM_POST_SCRAPER_ACTOR_ID=apify/instagram-post-scraper
APIFY_INSTAGRAM_COMMENT_SCRAPER_ACTOR_ID=apify/instagram-comment-scraper
# Legacy alias used only when APIFY_INSTAGRAM_HASHTAG_SCRAPER_ACTOR_ID is unset.
# APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-hashtag-scraper

# Deep thinking uses one Hashtag Scraper run per search. Actor result cap and
# completed-dataset paging cap are separate; the displayed 10-row UI is separate.
TUBITEX_APIFY_MAX_RESULTS_PER_ACTOR=1000
TUBITEX_APIFY_MAX_DATASET_ITEMS_PER_RUN=3000
TUBITEX_APIFY_DATASET_PAGE_SIZE=250
# Retained for other actor-orchestration work; current hashtag path runs once.
TUBITEX_APIFY_MAX_ACTOR_RUNS_PER_QUERY=4
TUBITEX_APIFY_MAX_COMMENT_POSTS_PER_QUERY=5
TUBITEX_APIFY_TIMEOUT_MS=120000
# Optional USD cap applied to each Actor run; blank means no dollar cap.
TUBITEX_APIFY_MAX_TOTAL_CHARGE_USD=
